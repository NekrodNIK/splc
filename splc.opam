opam-version: "2.0"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.5.0" & < "5.6.0"}
  "ppx_string"
  "ppx_deriving"
  "yojson"
  "ocaml-lsp-server" {with-dev-setup}
  "ocamlformat" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
